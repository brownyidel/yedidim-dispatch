{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yedidim-dispatch",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
